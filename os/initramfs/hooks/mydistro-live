#!/bin/sh
# initramfs-tools hook — adds squashfs and overlay support to the initrd.
# Picked up by update-initramfs when the kernel is installed.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac

. /usr/share/initramfs-tools/hook-functions

manual_add_modules squashfs overlay loop
